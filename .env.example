# Railway injects PORT automatically; set it only for local runs.
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Shared secret. When set, every /validate call must send `x-api-key`.
# Leave unset locally; set it on Railway so the endpoint is not open.
API_KEY=

# DNS-over-HTTPS behaviour
DNS_CACHE_TTL_SECONDS=3600
DNS_TIMEOUT_MS=4000

# Disposable blocklist refresh. DISPOSABLE_OFFLINE=true serves the bundled
# seed list only, with no network fetch.
DISPOSABLE_REFRESH_HOURS=24
DISPOSABLE_OFFLINE=false

# Optional Tier 1 hosted verifier. Leave both unset to run free-only.
# EMAIL_VERIFY_PROVIDER=abstract   # or: checkmail
# EMAIL_VERIFY_API_KEY=

# Verdict thresholds
SCORE_VALID_THRESHOLD=70
SCORE_SUSPICIOUS_THRESHOLD=40
